# Tokyo Night theme
font=JetBrainsMono Nerd Font
font-size=24

show-failed-attempts=true
show-caps-lock-text=true

# Background
screenshot
effect-blur=7x5
color=1a1b2666

# Inside (password input area)
inside-color=24283b
inside-clear-color=24283b
inside-ver-color=24283b
inside-wrong-color=24283b

# Ring (outer circle)
ring-color=bb9af7
ring-clear-color=9ece6a
ring-ver-color=7dcfff
ring-wrong-color=f7768e

# Text
text-color=c0caf5
text-clear-color=1a1b26
text-ver-color=1a1b26
text-wrong-color=1a1b26

# Key highlight
key-hl-color=bb9af7

# Separator
separator-color=24283b

# Line
line-color=24283b
line-clear-color=24283b
line-ver-color=24283b
line-wrong-color=24283b

# Layout message
layout-text-color=bb9af7

# Clock
show-clock

# Indicator
indicator-radius=100
indicator-thickness=10
