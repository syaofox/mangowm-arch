{
  "modules-left": [
    "ext/workspaces",
    // "custom/sep",
    "dwl/window#layout",
    "custom/sep",
    "dwl/window#title"
  ],
  "modules-right": [
    // "custom/sep",
    // "battery",
    // "custom/sep",
    // "network",
    // "custom/sep",
    "custom/net-speed",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "cpu",
    "temperature",
    "memory",
    "custom/sep",
    // "disk",
    // "custom/sep",
    "custom/gpu-stats",
    "custom/sep",
    "clock",
    "custom/sep",
    "tray"
  ],

  "clock": {
    "format": "{:%a %m-%d %H:%M}",
    "format-alt": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "CPU: {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "Mem: {used}GiB"
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "Disk: {free}"
  },
  // "battery": {
  //   "states": {
  //     "good": 95,
  //     "warning": 30,
  //     "critical": 15
  //   },
  //   "format": "Bat: {capacity}% {icon} {time}",
  //   "format-plugged": "{capacity}% ",
  //   "format-alt": "Bat {capacity}%",
  //   "format-time": "{H}:{M}",
  //   "format-icons": ["", "", "", "", ""]
  // },
  "network": {
    "format": "Online",
    "format-disconnected": "Disconnected ⚠"
  },
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": false,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true
  },
  "dwl/window#layout": {
    "format": "[{layout}]",
    "icon-spacing": 0
  },
  "dwl/window#title": {
    "format": "{title}"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": " {volume}%",
    "format-icons": ["", "", ""],
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "custom/gpu-stats": {
    "exec": "~/.local/bin/gpu-stats",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C"
  },
  "custom/net-speed": {
    "exec": "~/.local/bin/net-speed",
    "interval": 1,
    "format": "{}",
    "tooltip": false
  },
  "custom/sep": {
    "format": "|",
    "interval": 0
  }
}
