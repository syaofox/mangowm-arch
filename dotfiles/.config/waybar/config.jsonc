{
  "modules-left": [
    "ext/workspaces",
    // "custom/sep",
    "dwl/window#layout",
    "custom/sep",
    "dwl/window#title"
  ],
  "modules-right": [
    "custom/net-speed",
    "custom/sep",
    "cpu",
    "temperature",
    "memory",
    "custom/sep",
    "custom/gpu-stats",
    "custom/sep",
    "clock",
    "custom/sep",
    "pulseaudio",
    "tray"
  ],

  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": false,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true
  },
  "dwl/window#layout": {
    "format": "[{layout}]",
  },
  "dwl/window#title": {
    "format": "{title}"
  },

  "custom/net-speed": {
    "exec": "~/.local/bin/net-speed",
    "interval": 1,
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    "format": "{:%a %m-%d %H:%M}",
    "format-alt": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": false
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C"
  },
  "memory": {
    "format": "MEM {used}G"
  },

  "custom/gpu-stats": {
    "exec": "~/.local/bin/gpu-stats",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
 
"pulseaudio": {
    "format": "{icon}",
    "format-muted": " ",
    "format-icons": ["", "", ""],
    "on-click": "~/.config/mango/volume.sh mute",
    "on-scroll-up": "~/.config/mango/volume.sh up",
    "on-scroll-down": "~/.config/mango/volume.sh down"
  },

  "custom/sep": {
    "format": "|",
    "interval": 0
  }
}
